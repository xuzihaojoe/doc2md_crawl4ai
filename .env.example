############################
# doc2md web (后端配置示例)
############################

# 强烈建议改成随机串（用于 Cookie Session 签名）
APP_SECRET_KEY=CHANGE_ME__PLEASE_SET_ENV

# 允许前端跨域（开发模式）
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MySQL（生产建议） ---
# mysql+pymysql://user:password@127.0.0.1:3306/doc2md?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/doc2md?charset=utf8mb4

# --- 七牛云（可选） ---
QINIU_ENABLED=false
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# 例如：https://xxx.your-cdn-domain.com
QINIU_PUBLIC_DOMAIN=
QINIU_KEY_PREFIX=doc2md/

